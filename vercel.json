{
 "cleanUrls": true,
 "crons": [
  {
   "path": "/api/ping",
   "schedule": "17 14 * * *"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    }
   ]
  }
 ]
}